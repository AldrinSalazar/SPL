# "Hello, dear human!" rendered as SPL 2
# RATE=24000, DURATION=1.8s, SEED=7

spl 2 24000 1.8 7

# --- Voiced body: pitch + gain contour across all syllables,
# --- with an absolute-frequency formant spectrum for a vowel-like timbre.
harmonics
spectrum
0 0
300 0.3
500 1.0
800 0.4
1200 0.5
1500 0.9
2000 0.3
2500 0.6
3500 0.2
5000 0.05
8000 0
curve
0.00 100 0
0.02 105 0.25
0.12 140 0.3
0.20 130 0.28
0.25 115 0.3
0.42 95 0.25
0.50 90 0
0.60 110 0
0.62 120 0.28
0.80 115 0.3
0.90 100 0
0.98 100 0
1.00 130 0.26
1.15 150 0.3
1.25 145 0.32
1.45 95 0.2
1.55 85 0
1.80 85 0
end

# --- Aspiration noise for the "H" in "Hello"
noise
0 500 4000 0.08 0.3
0.05 500 4000 0 0.3
end

# --- Aspiration noise for the "H" in "human"
noise
0.95 500 4000 0.07 0.3
1.0 500 4000 0 0.3
end

# --- Brief broadband burst for the "d" stop in "dear"
hit
0.60 0.008 200 6000 0.15 0.2
end
